{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["gru1"],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/expire-plans", "schedule": "0 3 * * *" },
    { "path": "/api/cron/reconcile-checkouts", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/reconcile-subscriptions", "schedule": "5,35 * * * *" },
    { "path": "/api/cron/sweep-received", "schedule": "12,42 * * * *" },
    { "path": "/api/cron/abandoned-leads", "schedule": "*/15 * * * *" }
  ]
}
